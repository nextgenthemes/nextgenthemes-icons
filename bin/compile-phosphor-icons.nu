#!/usr/bin/env nu

# Compile Phosphor Icons metadata into a single PHP data file.
#
# Scans public/icons/phosphor/{svgs,svgs-flat}/<weight>/*.svg and writes
# src/data/phosphor.php keyed by icon collection slug:
#
#   phosphor-<weight>     → svgs/
#   phosphorflat-<weight> → svgs-flat/
#
# Usage:
#   nu bin/compile-phosphor.nu

const trees = [
	{prefix: 'phosphor' dir: 'svgs'}
	{prefix: 'phosphorflat' dir: 'svgs-flat'}
]

const weights = [bold duotone fill light regular thin]

# Escape a value for PHP output.
def php-str [value: oneof<string, int>]: nothing -> string {
	$value | into string | str replace "'" "\\'"
}

# acorn-bold → Acorn bold
def humanize [stem: string]: nothing -> string {
	let spaced = ($stem | str replace --all '-' ' ')
	$spaced | str replace --regex '^[a-z]' { $in | str uppercase }
}

export def main [] {
	let out_php = ($env.PWD | path join 'src/data/phosphor.php')
	mkdir ($out_php | path dirname)

	let groups = (
		$trees | each {|t|
			$weights | each {|w|
				let pattern = (['public/icons/phosphor' $t.dir $w '*.svg'] | path join)
				let slugs = (glob $pattern | each {|p| $p | path parse | get stem } | sort)

				if ($slugs | is-empty) {
					error make --unspanned { msg: $"no svgs found in ($pattern)" }
				}

				{
					collection: $"($t.prefix)-($w)"
					icons: ($slugs | each {|s| {slug: $s title: (humanize $s)} })
				}
			}
		} | flatten
	)

	let total = ($groups | each {|g| $g.icons | length } | math sum)
	print $"(ansi green_bold)($total)(ansi reset) icons across ($groups | length) collections"

	let tab = (char tab)
	let body = (
		$groups | each {|g|
			[
				$"($tab)'($g.collection)' => ["
				($g.icons | each {|i|
					let slug = (php-str $i.slug)
					let title = (php-str $i.title)
					$"($tab)(char tab)'($slug)' => [ 'title' => __\('($title)', 'nextgenthemes-icons'\) ],"
				} | str join "\n")
				$"($tab)],"
			] | str join "\n"
		} | str join "\n"
	)

	[
		'<?php'
		'// Generated by bin/compile-phosphor.nu — do not edit manually.'
		'return ['
		$body
		'];'
		''
	] | str join "\n" | save --force $out_php

	print $"(ansi green_bold)($out_php)(ansi reset)"
	print $"(ansi green_bold)done(ansi reset)"
}
