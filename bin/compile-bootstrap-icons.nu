

# Compile Bootstrap Icons metadata from .md files into PHP and JSON data files,
# and copy the SVG files into the plugin's public/icons/bootstrap/ directory.
#
# Usage:
#   nu bin/compile-icons.nu
#   nu bin/compile-icons.nu --json

const BS_ICONS_SVG_DIR = ('../../../vendor-repos/icons/icons' | path expand)
const BS_ICONS_MD_DIR = ('../../../vendor-repos/icons/docs/content/icons' | path expand)

# Get fenced yaml blocks from the top of markdown files.
def get-frontmatter [file: path]: nothing -> record {
	let content = (open --raw $file)
	let parts = ($content | split row '---')

	if ($parts | length) < 3 {
		return {}
	}

	let yaml_str = ($parts | get 1)

	if ($yaml_str | str trim | is-empty) {
		return {}
	}

	$yaml_str | from yaml
}

def rewrite-svg [file: path]: nothing -> nothing {
	let svg = (open --raw $file | from xml)

	$svg
		| update attributes { $in | reject width height }
		| to xml
		| save --force $file
}

# Escape a value for PHP output (single quotes stay around it at call site).
def php-str [value: oneof<string, int>]: nothing -> string {
	$value | into string | str replace "'" "\\'"
}

export def main [
	--json  # Also write the JSON data file
] {
	let plugin_dir = ([$env.PWD] | path expand)
	let out_svg_dir = ($plugin_dir | path join 'public/icons/bootstrap')
	let out_php = ($plugin_dir | path join 'src/data/bootstrap.php')

	if not ($BS_ICONS_MD_DIR | path exists) {
		error make --unspanned { msg: $"icons dir not found: ($BS_ICONS_MD_DIR)" }
	}

	mkdir $out_svg_dir
	mkdir ($out_php | path dirname)

	# Parse all .md frontmatter into a table.
	let icons = (
		glob ($BS_ICONS_MD_DIR | path join '*.md')
		| par-each {|path|
			let name = ($path | path parse | get stem)
			let meta = (get-frontmatter $path)

			{
				slug: $name
				title: ($meta.title? | default $name)
				# categories: ($meta.categories? | default [])
				# tags: ($meta.tags? | default [])
			}
		}
		| sort-by slug
	)

	print $"(ansi green_bold)($icons | length)(ansi reset) icons found"

	# let all_categories = ($icons | each {|i| $i.categories } | flatten | sort | uniq)
	# let all_tags = ($icons | each {|i| $i.tags } | flatten | sort | uniq)
	# print $"(ansi green_bold)($all_categories | length)(ansi reset) categories: ($all_categories | str join ', ')"
	# print $"(ansi green_bold)($all_tags | length)(ansi reset) tags"

	# Copy SVGs.
	let copied = (
		$icons | par-each {|icon|
			let src = ($BS_ICONS_SVG_DIR | path join $"($icon.slug).svg")
			let dest = ($out_svg_dir | path join $"($icon.slug).svg")
			if ($src | path exists) {
				cp $src $dest
				$icon.slug
			} else {
				print $'($src) does not exist!'
			}
		}
		| compact
		| length
	)

	print $"(ansi green_bold)($copied)(ansi reset) SVGs copied to public/icons/bootstrap/"

	# Rewrite the copied SVGs in place: 1em sizing, namespaced classes.
	let rewritten = (
		glob ($out_svg_dir | path join '*.svg')
			| par-each { |file|
				rewrite-svg $file
				$file
			}
			| length
	)

	print $"(ansi green_bold)($rewritten)(ansi reset) SVGs rewritten"

	# Write JSON (only with --json flag).
	if $json {
		let out_json = ($plugin_dir | path join 'src/data/bootstrap.json')
		$icons | to json | save --force $out_json
		print $"(ansi green_bold)($out_json)(ansi reset)"
	}

	# Write PHP — short array syntax, titles wrapped in __() for i18n.
	let php_lines = (
		[
			'<?php'
			'// Generated by bin/compile-icons.nu — do not edit manually.'
			'return ['
		]
 			| append ($icons | each { |icon|
 				# let cats = ($icon.categories | each {|c| $"'(php-str $c)'" } | str join ', ')
 				# let tags = ($icon.tags | each {|t| $"'(php-str $t)'" } | str join ', ')
 				let slug = (php-str $icon.slug)
 				let title = (php-str $icon.title)

 				$"(char tab)'($slug)' => [ 'title' => __\('($title)', 'nextgenthemes-icons'\) ],"
 				# $"(char tab)'($slug)' => [ 'title' => __\('($title)', 'nextgenthemes-icons'\), 'categories' => [($cats)], 'tags' => [($tags)] ],"
 			} )
			| append '];'
			| append ''
			| str join "\n"
	)

	$php_lines | save --force $out_php

	print $"(ansi green_bold)($out_php)(ansi reset)"
	print $"(ansi green_bold)done — ($icons | length) icons compiled(ansi reset)"
}
